# Vercel Environment Variables Template
# Copy these variables to your Vercel project dashboard

# Core Application
NODE_ENV=production
PORT=3000

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hocco?retryWrites=true&w=majority

# Redis Configuration  
REDIS_URL=redis://default:password@redis-host:port
REDIS_PASSWORD=your_redis_password

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here

# Admin Configuration
ADMIN_API_KEY=your_admin_api_key_here

# External Services
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here
STREEFI_API_URL=https://api.streefi.com
STREEFI_API_KEY=your_streefi_api_key
STREEFI_CLIENT_ID=your_streefi_client_id
STREEFI_ADMIN_API_KEY=your_streefi_admin_api_key

# CORS Configuration
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-domain.com

# Instructions:
# 1. Go to your Vercel project dashboard
# 2. Navigate to Settings > Environment Variables
# 3. Add each variable above with your actual values
# 4. Deploy your project